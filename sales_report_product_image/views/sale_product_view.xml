<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_order_image_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.sale.image</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <!-- Order line popup form: image before product -->
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id']"
                position="before"
            >
                <field name="image_small" widget="image" />
            </xpath>

            <xpath
                expr="//field[@name='order_line']/list/field[@name='sequence']"
                position="after"
            >
                <field
                    name="image_small"
                    widget="image"
                    string="Product Image"
                    width="80px"
                    options="{'size': [64, 64]}"
                />
            </xpath>

            <field name="payment_term_id" position="before">
                <field name="print_image" string="Print Image" />
                <field
                    name="image_sizes"
                    required="print_image != False"
                    string="Image Sizes"
                />
            </field>
        </field>
    </record>

</odoo>
