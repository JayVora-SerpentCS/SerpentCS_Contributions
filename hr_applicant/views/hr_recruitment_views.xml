<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_hr_applicant_medical_details_form">
        <field name="name">view.hr.applicant.medical.details.form</field>
        <field name="model">hr.applicant.medical.details</field>
        <field name="arch" type="xml">
            <form string="Medical Screening">
                <sheet>
                    <group>
                        <field
                            name="medical_examination"
                            placeholder="Enter Medical Examination"
                            required="1"
                        />
                        <field
                            name="vital_sign"
                            placeholder="Enter Vital Sign"
                            required="1"
                        />
                        <field name="date" placeholder="Enter Date" required="1" />
                        <field
                            name="doc_comment"
                            placeholder="Enter Doctor's Comment"
                        />
                        <field name="applicant_id" invisible="1" />
                    </group>
                    <group string="Details">
                        <group>
                            <label for="blood_name" />
                            <div class="o_row">
                                <field
                                    name="blood_name"
                                    class="o_hr_narrow_field"
                                    required="1"
                                />
                                <field
                                    name="blood_type"
                                    class="o_hr_narrow_field"
                                    required="1"
                                />
                            </div>
                            <field name="nose_sinuses" required="1" />
                            <field name="ears_tms" required="1" />
                            <field name="heart_vascular_system" required="1" />
                            <field name="abdomen_hernia" required="1" />
                            <field name="neurological" required="1" />
                            <field name="urine_drug_serene" required="1" />
                        </group>
                        <group>
                            <field name="head_face_scalp" required="1" />
                            <field name="mouth_throat" required="1" />
                            <field name="eyes_pupils_ocular" required="1" />
                            <field name="lungs" required="1" />
                            <field name="msk_strengh" required="1" />
                            <field name="glasses_needed" />
                            <field name="fit_for_full_duty" />
                        </group>
                    </group>
                    <group string="Medical History">
                        <group>
                            <field name="good_health" />
                            <field name="broken_bones" />
                            <field name="serious_wound" />
                            <field name="history_drug_use" />
                        </group>
                        <group>
                            <field name="serious_illness" />
                            <field name="medications" />
                            <field name="allergic" />
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview" />
                <chatter open_attachments="True" />
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="view_hr_applicant_medical_details_tree">
        <field name="name">view.hr.applicant.medical.details.list</field>
        <field name="model">hr.applicant.medical.details</field>
        <field name="arch" type="xml">
            <list string="Medical Screening">
                <field name="applicant_id" column_invisible="1" />
                <field name="medical_examination" />
                <field name="vital_sign" />
                <field name="date" />
            </list>
        </field>
    </record>
    <!-- Action Of Form & list Views Of Medical Details Button -->
    <record id="action_medical_details_list" model="ir.actions.act_window">
        <field name="name">Medical Details</field>
        <field name="res_model">hr.applicant.medical.details</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_applicant_medical_details_tree" />
        <field name="domain">[('applicant_id', '=', context.get('active_id'))]</field>
    </record>
    <record model="ir.ui.view" id="view_applicant_previous_occupation_tree">
        <field name="name">view.applicant.previous.occupation.list</field>
        <field name="model">applicant.previous.occupation</field>
        <field name="arch" type="xml">
            <list string="Prev. Occupation">
                <field name="applicant_id" column_invisible="1" />
                <field name="from_date" />
                <field name="to_date" />
                <field name="position" />
                <field name="organization" />
                <field name="ref_name" />
                <field name="ref_position" />
                <field name="ref_phone" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="view_applicant_previous_occupation_form">
        <field name="name">view.applicant.previous.occupation.form</field>
        <field name="model">applicant.previous.occupation</field>
        <field name="arch" type="xml">
            <form string="Previous Occupation" version="9.0">
                <sheet>
                    <field name="applicant_id" invisible="1" />
                    <group>
                        <group>
                            <field
                                name="organization"
                                placeholder="Enter Organization"
                                required="1"
                            />
                            <field name="ref_name" placeholder="Enter Reference Name" />
                            <field
                                name="ref_phone"
                                placeholder="Enter Reference Phone"
                                widget="phone"
                            />
                            <label string="Duration" for="from_date" />
                            <div>
                                <field
                                    name="from_date"
                                    widget="daterange"
                                    options="{'end_date_field': 'to_date'}"
                                />
                                <field
                                    name="to_date"
                                    placeholder="Enter To Date"
                                    invisible="1"
                                />
                            </div>
                        </group>
                        <group>
                            <field name="position" placeholder="Enter Position" />
                            <field
                                name="ref_position"
                                placeholder="Enter Reference Position"
                            />
                            <field
                                name="email"
                                placeholder="Enter Email"
                                widget="email"
                            />
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview" />
                <chatter open_attachments="True" />
            </form>
        </field>
    </record>
    <!-- Action Of Form & list Views Of Prev. Occupation Button -->
    <record id="action_prev_occupation_list" model="ir.actions.act_window">
        <field name="name">Previous Occupation</field>
        <field name="res_model">applicant.previous.occupation</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_applicant_previous_occupation_tree" />
        <field name="domain">[('applicant_id', '=', context.get('active_id'))]</field>
    </record>
    <record model="ir.ui.view" id="view_applicant_relative_tree">
        <field name="name">view.applicant.relative.list</field>
        <field name="model">applicant.relative</field>
        <field name="arch" type="xml">
            <list string="Relative">
                <field name="applicant_id" column_invisible="1" />
                <field name="relative_type" />
                <field name="name" placeholder="Enter Name" />
                <field name="birthday" placeholder="Enter Date of Birth" />
                <field name="place_of_birth" placeholder="Enter Place of Birth" />
                <field name="occupation" placeholder="Enter Occupation" />
                <field name="gender" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="view_applicant_relative_form">
        <field name="name">view.applicant.relative.form</field>
        <field name="model">applicant.relative</field>
        <field name="arch" type="xml">
            <form string="Relative" version="9.0">
                <sheet>
                    <field name="applicant_id" invisible="1" />
                    <group>
                        <group>
                            <field name="name" placeholder="Enter Name" />
                            <field name="birthday" placeholder="Enter Date of Birth" />
                            <field
                                name="place_of_birth"
                                placeholder="Enter Place of Birth"
                            />
                        </group>
                        <group>
                            <field
                                name="relative_type"
                                placeholder="Enter Relative Type"
                            />
                            <field
                                name="gender"
                                placeholder="Enter Gender"
                                readonly="relative_type not in ('Other', 'Children')"
                                force_save="1"
                            />
                            <field name="occupation" placeholder="Enter Occupation" />
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview" />
                <chatter open_attachments="True" />
            </form>
        </field>
    </record>
    <!-- Action Of Form & list Views Of Relatives Button -->
    <record id="action_relatives_list" model="ir.actions.act_window">
        <field name="name">Relatives</field>
        <field name="res_model">applicant.relative</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_applicant_relative_tree" />
        <field name="domain">[('applicant_id', '=', context.get('active_id'))]</field>
    </record>
    <record model="ir.ui.view" id="view_applicant_education_tree">
        <field name="name">view.applicant.education.list</field>
        <field name="model">applicant.education</field>
        <field name="arch" type="xml">
            <list string="Education">
                <field name="applicant_id" column_invisible="1" />
                <field name="from_date" />
                <field name="to_date" />
                <field name="grade" />
                <field name="school_name" />
                <field name="illiterate" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="view_applicant_education_form">
        <field name="name">view.applicant.education.form</field>
        <field name="model">applicant.education</field>
        <field name="arch" type="xml">
            <form string="Education" version="9.0">
                <sheet>
                    <field name="applicant_id" invisible="1" />
                    <group>
                        <field
                            string="Is Illiterate?"
                            name="illiterate"
                            class="oe_inline"
                        />
                    </group>
                    <group>
                        <group>
                            <field
                                name="school_name"
                                placeholder="Enter School Name"
                                readonly="illiterate != False"
                                required="illiterate == False"
                            />
                            <label for="edu_type" string="School Location" />
                            <div class="o_address_format">
                                <field name="edu_type" readonly="illiterate != False" />
                                <field
                                    name="country_id"
                                    placeholder="Enter Country"
                                    invisible="edu_type != 'Abroad'"
                                    readonly="illiterate != False"
                                    class="o_address_country"
                                />
                                <field
                                    name="state_id"
                                    placeholder="Enter State"
                                    invisible="edu_type != 'Local'"
                                    readonly="illiterate != False"
                                    class="o_address_state"
                                />
                                <field
                                    name="province"
                                    placeholder="Enter Province"
                                    invisible="edu_type != 'Local'"
                                    readonly="illiterate != False"
                                />
                            </div>
                            <label for="from_date" string="Duration" />
                            <div>
                                <field
                                    name="from_date"
                                    readonly="illiterate != False"
                                    required="illiterate == False"
                                    widget="daterange"
                                    options="{'end_date_field': 'to_date'}"
                                />
                                <field
                                    name="to_date"
                                    readonly="illiterate != False"
                                    required="illiterate == False"
                                    invisible="1"
                                />
                            </div>
                        </group>
                        <group>
                            <field
                                name="education_rank"
                                placeholder="Enter Education Rank"
                                readonly="illiterate != False"
                                required="illiterate == False"
                            />
                            <field
                                name="grade"
                                placeholder="Enter Education Field"
                                readonly="illiterate != False"
                                required="illiterate == False"
                            />
                        </group>
                    </group>
                </sheet>
                <div class="o_attachment_preview" />
                <chatter open_attachments="True" />
            </form>
        </field>
    </record>
    <!-- Action Of Form & list Views Of Medical Button -->
    <record id="action_education_list" model="ir.actions.act_window">
        <field name="name">Education Details</field>
        <field name="res_model">applicant.education</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_applicant_education_tree" />
        <field name="domain">[('applicant_id', '=', context.get('active_id'))]</field>
    </record>
    <record model="ir.ui.view" id="view_applicant_previous_travel_tree">
        <field name="name">view.applicant.previous.travel.list</field>
        <field name="model">applicant.previous.travel</field>
        <field name="arch" type="xml">
            <list string="Previous Travel">
                <field name="applicant_id" column_invisible="1" />
                <field name="from_date" />
                <field name="to_date" />
                <field name="location" />
                <field name="reason" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="view_applicant_previous_travel_form">
        <field name="name">view.applicant.previous.travel.form</field>
        <field name="model">applicant.previous.travel</field>
        <field name="arch" type="xml">
            <form string="Previous Travel" version="9.0">
                <sheet>
                    <field name="applicant_id" invisible="1" />
                    <div class="oe_form_view_fields">
                        <group>
                            <group>
                                <label string="Duration" for="from_date" />
                                <div>
                                    <field
                                        name="from_date"
                                        widget="daterange"
                                        options="{'end_date_field': 'to_date'}"
                                    />
                                    <field
                                        name="to_date"
                                        placeholder="Enter To Date"
                                        invisible="1"
                                    />
                                </div>
                            </group>
                            <group>
                                <field name="location" placeholder="Enter Location" />
                            </group>
                            <field name="reason" placeholder="Enter Reason" />
                        </group>
                    </div>
                </sheet>
                <div class="o_attachment_preview" />
                <chatter open_attachments="True" />
            </form>
        </field>
    </record>
    <!-- Action Of Form & list Views Of Travels Button -->
    <record id="action_travels_list" model="ir.actions.act_window">
        <field name="name">Previous Travels</field>
        <field name="res_model">applicant.previous.travel</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_applicant_previous_travel_tree" />
        <field name="domain">[('applicant_id', '=', context.get('active_id'))]</field>
    </record>
    <record model="ir.ui.view" id="view_applicant_language_tree">
        <field name="name">view.applicant.language.list</field>
        <field name="model">applicant.language</field>
        <field name="arch" type="xml">
            <list string="Employee Language">
                <field name="applicant_id" column_invisible="1" />
                <field name="language" />
                <field name="read_lang" />
                <field name="write_lang" />
                <field name="speak_lang" />
                <field name="mother_tongue" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="view_applicant_language_form">
        <field name="name">view.applicant.language.form</field>
        <field name="model">applicant.language</field>
        <field name="arch" type="xml">
            <form string="Employee Language" version="9.0">
                <sheet>
                    <field name="applicant_id" invisible="1" />
                    <group col="2" colspan="4">
                        <field
                            name="language"
                            placeholder="Enter Language"
                            options="{'no_create': True, 'no_edit': True}"
                        />
                    </group>
                    <group col="6" colspan="6">
                        <field
                            name="read_lang"
                            widget="radio"
                            placeholder="Enter Reading Ability"
                        />
                        <field
                            name="write_lang"
                            widget="radio"
                            placeholder="Enter Writing Ability"
                        />
                        <field
                            name="speak_lang"
                            widget="radio"
                            placeholder="Enter Speaking Ability"
                        />
                    </group>
                    <group string="Mother Tongue" colspan="4">
                        <field name="mother_tongue" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action Of Form & list Views Of languages Button -->
    <record id="action_languages_list" model="ir.actions.act_window">
        <field name="name">Languages</field>
        <field name="res_model">applicant.language</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_applicant_language_tree" />
        <field name="domain">[('applicant_id', '=', context.get('active_id'))]</field>
    </record>
    <!-- Inherited view of hr.applicant to add buttons -->
    <record id="view_hr_applicant_inherited" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherited</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <newline />
                <button
                    name="%(action_medical_details_list)d"
                    type="action"
                    class="oe_inline oe_stat_button"
                    icon="fa-medkit"
                    help="Add/Edit/Review Medical details of applicant"
                    invisible="employee_id != False"
                    context="{'default_applicant_id':context.get('active_id')}"
                >
                    <!-- attrs="{'invisible': [('employee_id', '!=', False)]}" -->
                    <field
                        name="no_of_medical"
                        widget="statinfo"
                        string="Medical Details"
                    />
                </button>
                <button
                    name="%(action_prev_occupation_list)d"
                    type="action"
                    style="width:198px !important"
                    class="oe_inline oe_stat_button"
                    icon="fa-history"
                    help="Add/Edit/Review Previous Occupation details of applicant"
                    context="{'default_applicant_id':context.get('active_id')}"
                >
                    <field
                        name="no_of_prev_occu"
                        widget="statinfo"
                        string="Previous Occupations"
                    />
                </button>
                <button
                    name="%(action_education_list)d"
                    type="action"
                    style="width:197px !important"
                    class="oe_inline oe_stat_button"
                    icon="fa-book"
                    help="Add/Edit/Review Education details of applicant"
                    context="{'default_applicant_id':context.get('active_id')}"
                >
                    <field
                        name="no_of_education"
                        widget="statinfo"
                        string="Education Details"
                    />
                </button>
                <button
                    name="%(action_relatives_list)d"
                    type="action"
                    style="width:119px !important"
                    class="oe_inline oe_stat_button"
                    icon="fa-users"
                    help="Add/Edit/Review Relative details of applicant"
                    context="{'default_applicant_id':context.get('active_id')}"
                >
                    <field name="no_of_relative" widget="statinfo" string="Relatives" />
                </button>
                <button
                    name="%(action_languages_list)d"
                    type="action"
                    class="oe_inline oe_stat_button"
                    icon="fa-font"
                    help="Add/Edit/Review Languages of applicant"
                    context="{'default_applicant_id':context.get('active_id')}"
                >
                    <field name="no_of_lang" widget="statinfo" string="Languages" />
                </button>
                <button
                    name="%(action_travels_list)d"
                    type="action"
                    style="width:145px !important"
                    class="oe_inline oe_stat_button"
                    icon="fa-car"
                    help="Add/Edit/Review Previous Travel details of applicant"
                    context="{'default_applicant_id':context.get('active_id')}"
                >
                    <field
                        name="no_of_prev_travel"
                        widget="statinfo"
                        string="Previous Travels"
                    />
                </button>
                <button
                    name="%(action_medical_details_list)d"
                    type="action"
                    class="oe_inline oe_stat_button"
                    icon="fa-medkit"
                    help="Add/Edit/Review Medical details of applicant"
                    invisible="employee_id == False"
                    context="{'default_applicant_id':context.get('active_id')}"
                >
                    <!-- attrs="{'invisible': [('employee_id', '=', False)]}" -->
                    <field
                        name="no_of_medical1"
                        widget="statinfo"
                        string="Medical Details"
                    />
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_name']" position="attributes">
                <attribute name="required">True</attribute>
            </xpath>
            <button name="create_employee_from_applicant" position="replace">
                <button
                    string="Create Employee"
                    name="%(action_select_training_wizard)d"
                    type="action"
                    class="oe_highlight"
                    invisible="employee_id or not active or not date_closed"
                />
                    <!-- attrs="{'invisible': ['|',('employee_id', '!=', False),('active', '=', False)]}" -->
            </button>
        </field>
    </record>
</odoo>
